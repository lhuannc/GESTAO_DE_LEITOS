{
  "name": "gestao-leitos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:cmd": "scripts\\setup.cmd",
    "setup:unix": "bash scripts/setup.sh",
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\" --names \"API,WEB\" --prefix-colors \"cyan,magenta\"",
    "db:reset": "powershell -ExecutionPolicy Bypass -File scripts/reset-db.ps1",
    "db:reset:unix": "bash scripts/reset-db.sh",
    "db:studio": "npm run db:studio --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.8.2"
  }
}
